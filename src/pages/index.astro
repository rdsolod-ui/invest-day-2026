---
import CeoBlock from '../components/CeoBlock.astro';
import FinanceBlock from '../components/FinanceBlock.astro';
import SpeakerScene from '../components/SpeakerScene.astro';
import CmoBlock from '../components/CmoBlock.astro';
import speakers from '../data/speakers.json';
const totalScenes=29;
import '../styles/site.css';
import '../styles/revision.css';
import '../styles/finance.css';
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
const asset=(s:string)=>`${base}/assets/${s}`;
const nav=[['industry-location','Индустрия'],['product','Продукт'],['investment','Финансы'],['baseline','Перспектива']];
---
<!doctype html>
<html lang="ru">
<head>
<meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
<title>Инвест День 2026 · Парк Сказка</title>
<meta name="description" content="От районного парка к городскому масштабу. Трансформация продукта, инвестиционная программа, результаты и целевые ориентиры Парка Сказка."/>
<meta name="theme-color" content="#102B46"/>
<link rel="canonical" href="https://marketing.parkskazka.ru/invest-day-2026/"/>
<meta property="og:title" content="Инвест День 2026 · Парк Сказка"/><meta property="og:description" content="Новый масштаб парка. Реальные инвестиции. Перспектива полного сезона."/><meta property="og:type" content="website"/><meta property="og:locale" content="ru_RU"/><meta property="og:image" content={`https://marketing.parkskazka.ru${asset('park-wide.webp')}`}/>
<link rel="icon" type="image/svg+xml" href={asset('skazka-logo.svg')}/>
<link rel="preload" href={asset('manrope.woff2')} as="font" type="font/woff2" crossorigin/>
<link rel="preload" href={asset('golos.woff2')} as="font" type="font/woff2" crossorigin/>
<script is:inline>try{const t=localStorage.getItem('invest-theme')||'system';document.documentElement.dataset.theme=t==='system'?(matchMedia('(prefers-color-scheme:dark)').matches?'dark':'light'):t;document.documentElement.dataset.preference=t;}catch{document.documentElement.dataset.theme=matchMedia('(prefers-color-scheme:dark)').matches?'dark':'light';}</script>
</head>
<body>
<a class="skip" href="#main">К содержанию</a>
<header class="topbar">
<a href="#start" class="brand" aria-label="Парк Сказка — начало презентации"><img src={asset('skazka-logo.svg')} width="151" height="40" alt="Сказка"/></a>
<div class="edition">Инвест День <span>2026</span></div>
<nav class="main-nav" aria-label="Главы презентации">{nav.map(([id,label])=><a href={`#${id}`}>{label}</a>)}</nav>
<div class="header-actions"><label class="theme-picker"><span class="sr-only">Тема оформления</span><select id="theme" aria-label="Тема оформления"><option value="system">Системная</option><option value="light">Светлая</option><option value="dark">Тёмная</option></select></label><button id="start-show" class="button small" hidden>Начать показ <span aria-hidden="true">↗</span></button></div>
</header>
<main id="main">
<div class="scene-shell"><section class="scene hero" id="start" data-title="Новый масштаб"><img class="stage-brand" src={asset('skazka-logo.svg')} alt="Сказка" width="145" height="38"/><span class="stage-index">01 / {totalScenes}</span>
<img class="hero-background" src={asset('park-wide.webp')} alt="Панорама парка Сказка в Крылатском" width="1400" height="933" fetchpriority="high"/>
<div class="hero-shade"></div><div class="hero-copy"><p class="eyebrow" data-reveal>Парк Сказка · Инвест День 2026</p><h1 data-reveal>Новый<br/><span>масштаб.</span></h1><p class="hero-lead" data-reveal>От районного парка<br/>к городскому продукту на целый день.</p><a class="hero-link" href="#speaker-viktor">Начало выступлений <span>↗</span></a></div>
<div class="hero-stamp" aria-hidden="true">20<br/>26</div><div class="scene-foot"><span>Москва · Крылатское</span><span>Продукт / Инвестиции / Результат</span><span>01 / {totalScenes}</span></div>
</section></div>
<SpeakerScene speaker={speakers[0]} total={totalScenes}/>
<CeoBlock total={totalScenes}/>
<SpeakerScene speaker={speakers[1]} total={totalScenes}/>
<CmoBlock total={totalScenes}/>
<SpeakerScene speaker={speakers[2]} total={totalScenes}/>
<FinanceBlock total={totalScenes}/>
<SpeakerScene speaker={speakers[3]} total={totalScenes}/>
<div class="scene-shell"><section class="scene section closing night" id="discussion" data-title="Итоги и вопросы"><img class="stage-brand" src={asset('skazka-logo.svg')} alt="Сказка" width="145" height="38"/><span class="stage-index">29 / {totalScenes}</span>
<img class="closing-background" src={asset('wheel.webp')} alt="Колесо обозрения в парке Сказка" loading="lazy"/><div class="closing-shade"></div><div class="closing-copy"><p class="eyebrow" data-reveal>11 / Следующая глава</p><h2 data-reveal>Новый масштаб.<br/><span>Полный сезон.</span></h2><div class="closing-points"><p data-reveal>Инвестиции создали инфраструктуру.</p><p data-reveal>Спрос и качество результата растут.</p><p data-reveal>Следующий шаг — реализация потенциала.</p></div><strong class="questions">Вопросы и обсуждение <span>↗</span></strong></div>
</section></div>
</main>
<aside class="show-controls" aria-label="Управление показом" hidden><button id="prev-scene" aria-label="Предыдущая сцена">←</button><span id="scene-count" aria-live="polite">1 / {totalScenes}</span><button id="next-scene" aria-label="Следующая сцена">→</button><button id="full-screen" aria-label="Полноэкранный режим" aria-pressed="false">⛶</button><button id="motion-toggle" aria-pressed="false">Движение</button><button id="hide-controls" aria-label="Скрыть панель, вернуть клавишей H">Скрыть · H</button><button id="end-show">Завершить <span>Esc</span></button></aside>
<div class="reading-progress" aria-hidden="true"><span></span></div>
<script>import '../scripts/site.ts';</script>
<script is:inline defer src={asset('invest-questions.js')}></script>
</body>
</html>
