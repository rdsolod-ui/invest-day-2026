---
import Head from '../components/SectionHead.astro';
import Source from '../components/Source.astro';
import Chart from '../components/ComparisonChart.astro';
import data from '../data/metrics.json';
import sources from '../data/sources.json';
import '../styles/site.css';
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
const asset=(s:string)=>`${base}/assets/${s}`;
const n=(v:number,d=1)=>new Intl.NumberFormat('ru-RU',{minimumFractionDigits:d,maximumFractionDigits:d}).format(v);
const integer=(v:number)=>new Intl.NumberFormat('ru-RU').format(v);
const d=data.demand, f=data.finance, investment=data.investment;
const traffic=d.tickets.map((v,i)=>v/(d.conversion[i]/100)/1000);
const growth=Math.round((d.tickets[1]/d.tickets[0]-1)*100);
const rows=f.rows;
const nav=[['story','История'],['product','Продукт'],['investment','Финансы'],['targets','Перспектива']];
---
<!doctype html>
<html lang="ru">
<head>
<meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
<title>Инвест День 2026 · Парк Сказка</title>
<meta name="description" content="От районного парка к городскому масштабу. Трансформация продукта, инвестиционная программа, результаты и целевые ориентиры Парка Сказка."/>
<meta name="theme-color" content="#102B46"/>
<link rel="canonical" href="https://marketing.parkskazka.ru/invest-day-2026/"/>
<meta property="og:title" content="Инвест День 2026 · Парк Сказка"/><meta property="og:description" content="Новый масштаб парка. Реальные инвестиции. Перспектива полного сезона."/><meta property="og:type" content="website"/><meta property="og:locale" content="ru_RU"/><meta property="og:image" content={`https://marketing.parkskazka.ru${asset('park-wide.webp')}`}/>
<link rel="icon" type="image/svg+xml" href={asset('skazka-logo.svg')}/>
<link rel="preload" href={asset('manrope.woff2')} as="font" type="font/woff2" crossorigin/>
<link rel="preload" href={asset('golos.woff2')} as="font" type="font/woff2" crossorigin/>
<script is:inline>try{const t=localStorage.getItem('invest-theme')||'system';document.documentElement.dataset.theme=t==='system'?(matchMedia('(prefers-color-scheme:dark)').matches?'dark':'light'):t;document.documentElement.dataset.preference=t;}catch{document.documentElement.dataset.theme=matchMedia('(prefers-color-scheme:dark)').matches?'dark':'light';}</script>
</head>
<body>
<a class="skip" href="#main">К содержанию</a>
<header class="topbar">
<a href="#start" class="brand" aria-label="Парк Сказка — начало презентации"><img src={asset('skazka-logo.svg')} width="151" height="40" alt="Сказка"/></a>
<div class="edition">Инвест День <span>2026</span></div>
<nav class="main-nav" aria-label="Главы презентации">{nav.map(([id,label])=><a href={`#${id}`}>{label}</a>)}</nav>
<div class="header-actions"><label class="theme-picker"><span class="sr-only">Тема оформления</span><select id="theme" aria-label="Тема оформления"><option value="system">Системная</option><option value="light">Светлая</option><option value="dark">Тёмная</option></select></label><button id="start-show" class="button small" hidden>Начать показ <span aria-hidden="true">↗</span></button></div>
</header>
<main id="main">
<section class="scene hero" id="start" data-title="Новый масштаб">
<div class="hero-copy"><p class="eyebrow" data-reveal>Парк Сказка · Москва</p><h1 data-reveal>От районного парка<br/><span>к городскому<br/>масштабу.</span></h1><p class="hero-lead" data-reveal>Новый продукт. Реальные инвестиции.<br/>Перспектива полного сезона.</p><a class="hero-link" href="#story">История трансформации <span aria-hidden="true">↓</span></a><span class="hero-date">Материалы на 10 сентября 2026</span></div>
<div class="hero-visual"><img src={asset('park-wide.webp')} alt="Парк Сказка в Крылатском: аттракционы и зелёная территория" width="1400" height="933" fetchpriority="high"/><div class="photo-caption">Сказка, Крылатское <span>Москва</span></div><svg class="hero-orbit" viewBox="0 0 600 400" fill="none" aria-hidden="true"><path d="M-40 370C120 410 520 340 480 145S250 80 270 220S590 430 650 110"/><circle cx="480" cy="145" r="7"/></svg></div>
<div class="hero-bottom"><span>Одна история развития</span><span>Продукт <b>→</b> Инвестиции <b>→</b> Результат</span><span>01 / 12</span></div>
</section>
<section class="scene section" id="story" data-title="Трансформация">
<Head eyebrow="01 / История парка" title="Больше, чем отдельный аттракцион." description="Переход к городскому формату меняет саму причину визита: в парк приезжают провести целый день."/>
<div class="story-grid"><div class="story-before" data-reveal><span class="label">Исходная модель</span><h3>Районный<br/>парк</h3><p>Восемь лет развития вокруг отдельных активностей и локального спроса.</p></div><div class="story-bridge" aria-hidden="true"><svg viewBox="0 0 180 260"><path d="M5 220C130 220 10 40 160 40" fill="none"/><path d="m145 25 17 15-17 15" fill="none"/></svg><span>Инвестиционный<br/>контракт</span></div><div class="story-after" data-reveal><span class="label">Новая модель</span><h3>Городской<br/>продукт на день</h3><p>Больше сценариев, шире география гостей и единая инфраструктура впечатлений.</p></div></div>
<Source id="protocol-2026">Стратегический контекст · материалы совещания 07.09.2026.</Source>
</section>
<section class="scene section tinted" id="scale" data-title="Масштаб изменений">
<Head eyebrow="02 / Масштаб трансформации" title="Изменения, которые можно увидеть." description="Продукт, площадки и территория растут вместе."/>
<div class="scale-grid">{data.transformation.map((m,i)=><article class={`scale-card scale-${i}`} data-reveal><span class="label">{m.note}</span><strong>{m.value}</strong><h3>{m.label}</h3></article>)}</div>
<Source id="protocol-2026">Показатели из материалов 07.09.2026. Периоды сравнения и методика площади требуют уточнения.</Source>
</section>
<section class="scene section" id="product" data-title="Продукт на целый день">
<Head eyebrow="03 / Продукт и аудитория" title="Один парк. Много поводов вернуться." description="Единый билет связывает аттракционы и впечатления. События, праздники и питание расширяют сценарий визита."/>
<div class="product-grid"><figure class="product-feature" data-reveal><img src={asset('bumerang.webp')} alt="Аттракцион Бумеранг в парке Сказка" loading="lazy" width="1200" height="754"/><figcaption><span>Новые впечатления</span><h3>Экстрим расширяет<br/>аудиторию парка.</h3></figcaption></figure><div class="product-side"><img src={asset('family.webp')} alt="Детские аттракционы в парке Сказка" loading="lazy" width="900" height="600"/><ul class="product-list"><li><span>01</span>Семейный день</li><li><span>02</span>Дни рождения</li><li><span>03</span>Корпоративные события</li><li><span>04</span>Кафе, прогулки и мероприятия</li></ul></div></div>
<Source id="protocol-2026">Продуктовый сценарий · материалы совещания и выступления. Фотографии: официальный сайт парка.</Source>
</section>
<section class="scene section investment-section" id="investment" data-title="Инвестиционная программа">
<Head eyebrow="04 / Финансовый блок · Инвестиции" title="Инвестиции стали инфраструктурой." description="Основные вложения сделаны. Завершается ввод новых мощностей."/>
<div class="investment-grid"><div class="investment-number" data-reveal><span class="label">Совокупные вложения</span><strong>≈{n(investment.value)}</strong><span class="unit">млрд ₽</span><p>{investment.status}</p></div><div class="investment-details"><div class="two-stats"><div data-reveal><strong>{investment.preparedHectares}<small> га</small></strong><p>территории подготовлено<br/>под новую зону</p></div><div data-reveal><strong>{investment.rides}</strong><p>аттракционов:<br/>{investment.ownRides} собственных · {investment.partnerRides} партнёрских</p></div></div><div class="investment-lines"><p><span>Оборудование</span><b>01</b></p><p><span>Основания, монтаж и сети</span><b>02</b></p><p><span>Благоустройство и гостевая среда</span><b>03</b></p></div><p class="note">Парк создаёт инфраструктуру и поток гостей. Партнёры финансируют часть аттракционов.</p></div></div>
<Source id="finance-1">Управленческая оценка · сентябрь 2026. Объектная разбивка вложений не представлена.</Source>
</section>
<section class="scene section" id="baseline" data-title="Исходный план 2024">
<Head eyebrow="05 / Историческая база" title="Сохраняем точку отсчёта." description="Оценки и цели, представленные инвесторам в материалах выпуска 2024 года."/>
<div class="baseline-grid"><div class="baseline-card"><span class="label">Оценка 2024</span><div><strong>{n(data.historical.revenue)}<small> млрд ₽</small></strong><p>выручка</p></div><div><strong>{n(data.historical.traffic)}<small> млн</small></strong><p>посетителей за год</p></div><div><strong>{data.historical.repeat}<small>%</small></strong><p>повторных посещений</p></div></div><div class="plan-table-wrap"><p class="label">Первоначальные цели · план 2024 года</p><table class="data-table"><caption class="sr-only">Первоначальные цели выручки и трафика</caption><thead><tr><th scope="col">Год</th><th scope="col">Выручка,<br/>млрд ₽</th><th scope="col">Трафик,<br/>млн гостей</th></tr></thead><tbody>{data.oldPlan.map(row=><tr><th scope="row">{row.year}</th><td>{n(row.revenue)}</td><td>{n(row.traffic,row.traffic===2.25?2:1)}</td></tr>)}</tbody></table><p class="note">Исторические оценки и плановые значения.<br/>Не являются фактическими результатами этих лет.</p></div></div>
<Source id="finance-2">Материалы выпуска 2024 года, приведённые в финансовом блоке.</Source>
</section>
<section class="scene section tinted" id="demand" data-title="Спрос и билеты">
<Head eyebrow="06 / Спрос" title="Больше гостей выбирают билет." description="Сопоставимый период: апрель–август 2025 и 2026 годов."/>
<div class="demand-layout"><div class="demand-charts"><Chart title="Оплаченные билеты" values={d.tickets.map(x=>x/1000)} max={300} labels={['2025','2026']} unit="тыс. билетов"/><Chart title="Расчётный входящий поток" values={traffic} max={450} labels={['2025','2026']} unit="тыс. гостей" approximate/></div><div class="demand-summary"><div data-reveal><strong>+{growth}%</strong><p>оплаченных билетов</p><small>{integer(d.tickets[0])} → {integer(d.tickets[1])}</small></div><div data-reveal><strong>{d.conversion[0]}<small>%</small><span class="thin-arrow"> → </span>{d.conversion[1]}<small>%</small></strong><p>доля оплативших во входящем потоке</p><span class="pill">+{d.conversion[1]-d.conversion[0]} п.п.</span></div><div class="rides-note"><strong>{n(d.rides/1000)} тыс.</strong><p>проходов на {d.newObjects} новых аттракционах<br/>{d.ridesPeriod}</p><small>Проходы — отдельная метрика, не уникальные гости.</small></div></div></div>
<details class="data-details"><summary>Методика и точные значения</summary><p>Расчёт входящего потока: число билетов / доля оплативших. Доли 40% и 65% округлены, поэтому поток показан приблизительно: {integer(Math.round(traffic[0]*1000))} и {integer(Math.round(traffic[1]*1000))}. Расчётный рост — около 20%. Публичная редакция и методика билетного учёта требуют сверки с первичными данными.</p><table class="data-table"><caption>Апрель–август</caption><thead><tr><th scope="col">Год</th><th scope="col">Билеты</th><th scope="col">Доля оплативших</th></tr></thead><tbody>{d.years.map((y,i)=><tr><th scope="row">{y}</th><td>{integer(d.tickets[i])}</td><td>{d.conversion[i]}%</td></tr>)}</tbody></table></details>
<Source id="finance-3">Данные финансового блока. Входящий поток — расчёт по округлённым долям.</Source>
</section>
<section class="scene section" id="calendar" data-title="Календарь ввода">
<Head eyebrow="07 / Календарь реализации" title="Полный эффект следует за запуском." description="Новые объекты начали работать позже исходного графика. Первый полный сезон новой зоны — ориентир 2027 года."/>
<div class="calendar-grid"><div class="timeline"><article data-reveal><span>2024</span><div><h3>Исходный план</h3><p>Новые мощности должны были работать с начала высокого сезона.</p></div></article><article data-reveal><span>2025</span><div><h3>Слабый сезон</h3><p>Холодное и дождливое лето, ограниченная готовность колеса обозрения.</p></div></article><article class="current" data-reveal><span>2026</span><div><h3>Поздний ввод</h3><p>Подготовка территории, производство, поставки, монтаж и пусконаладка заняли больше времени.</p></div></article><article class="future" data-reveal><span>2027</span><div><h3>Первый полный сезон</h3><p>Возможность использовать новые мощности в течение всего высокого сезона.</p></div></article></div><figure class="calendar-photo"><img src={asset('smerch.webp')} alt="Аттракцион Смерч на фоне неба" loading="lazy" width="900" height="600"/><figcaption><strong>Смерч · Путь Дракона · Бумеранг</strong><span>По материалам: введены ближе к завершению сезона 2026.</span></figcaption></figure></div>
<div class="calendar-note"><span class="pill">План · октябрь 2026</span><p>«Сердце Москвы»: завершение пусконаладки и плановый запуск. Статус приведён на дату подготовки материалов.</p></div>
<Source id="finance-4">Управленческий график · срез 9–10 сентября 2026.</Source>
</section>
<section class="scene section finance-section" id="finance" data-title="Финансовый результат">
<Head eyebrow="08 / Экономика бизнеса" title="Качество результата меняется." description="Первое полугодие 2026: стабильная выручка при улучшении операционного результата."/>
<div class="finance-layout"><div class="financial-bars"><div class="legend"><span><i class="old-dot"></i>1П2025</span><span><i class="new-dot"></i>1П2026</span><span>млн ₽</span></div>{rows.slice(0,3).map(row=><Chart title={row.label} values={row.values} max={600} labels={['2025','2026']} unit="млн ₽" compact/>)}</div><div class="finance-result"><div class="result-card" data-reveal><span class="label">Результат от продаж</span><div class="old-result">{n(rows[3].values[0])}<span> млн ₽ · 1П2025</span></div><span class="result-arrow" aria-hidden="true">↓</span><strong>+{n(rows[3].values[1])}<small> млн ₽</small></strong><p>1П2026</p></div><div class="net-result" data-reveal><span class="label">Чистый результат, млн ₽</span><strong>{n(rows[4].values[0])} <span>→</span> +{n(rows[4].values[1])}</strong><p>1П2025 → 1П2026</p></div><div class="finance-deltas"><div><strong>+{n((rows[1].values[1]/rows[1].values[0]-1)*100)}%</strong><span>валовая прибыль</span></div><div><strong>−{n((1-rows[2].values[1]/rows[2].values[0])*100)}%</strong><span>операционные расходы</span></div></div></div></div>
<details class="data-details"><summary>Все показатели и пояснение к сравнению</summary><table class="data-table"><caption>Показатели первого полугодия, млн ₽</caption><thead><tr><th scope="col">Показатель</th><th scope="col">1П2025</th><th scope="col">1П2026</th></tr></thead><tbody>{rows.map(row=><tr><th scope="row">{row.label}</th><td>{n(row.values[0])}</td><td>{n(row.values[1])}</td></tr>)}</tbody></table><p>Значения приведены по финансовым материалам. Показатели показаны отдельно: состав OPEX и его сверка с результатом от продаж требуют уточнения. Графики не являются декомпозицией прибыли.</p></details>
<Source id="finance-5">Финансовый блок на основе бухгалтерской отчётности и управленческих расшифровок.</Source>
</section>
<section class="scene section target-section" id="targets" data-title="Целевые ориентиры">
<Head eyebrow="09 / Перспектива" title="Те же цели. Новый календарь." description="Целевые значения из материалов выпуска сдвинуты на один год вслед за фактическими сроками запуска."/>
<div class="target-head"><span>Прежний год</span><span>Сохранённый целевой масштаб</span><span>Новый ориентир</span></div>
<div class="target-rows">{data.targets.map((t,i)=><article class="target-row" data-reveal><span class="target-old">{t.oldYear}</span><div class="target-values"><strong>{n(t.revenue)}<small> млрд ₽</small></strong><span>{n(t.traffic)} млн гостей</span></div><div class="target-connector" aria-hidden="true"><span>+1 год</span><svg viewBox="0 0 220 25"><path d="M0 12H209m-10-8 10 8-10 8"/></svg></div><strong class="target-new">{t.year}</strong></article>)}</div>
<p class="target-footnote">{data.targetStatus}</p>
<Source id="finance-6">Актуализированный управленческий график · сентябрь 2026.</Source>
</section>
<section class="scene section" id="execution" data-title="Условия реализации">
<Head eyebrow="10 / Следующий этап" title="От строительства — к загрузке." description="Созданная инфраструктура — основа роста. Реализация целей требует ежедневной работы с продуктом, операциями и спросом."/>
<div class="execution-grid"><article data-reveal><span class="execution-number">01</span><h3>Полный сезон</h3><p>Завершение ввода и стабильная эксплуатация новой зоны в течение высокого сезона.</p></article><article data-reveal><span class="execution-number">02</span><h3>Единый продукт</h3><p>Работа единого билета, удобный гостевой маршрут и больше поводов для повторного визита.</p></article><article data-reveal><span class="execution-number">03</span><h3>Расширение спроса</h3><p>Продвижение обновлённого парка, привлечение новой аудитории и последовательная загрузка мощностей.</p></article></div>
<div class="execution-banner"><span>2027</span><p>Ориентир первого полного сезона<br/>новых мощностей.</p><svg viewBox="0 0 400 100" aria-hidden="true"><path d="M0 70C100 70 80 10 160 10S250 110 390 20" fill="none"/></svg></div>
<Source id="finance-6">Сценарий реализации из выступления Натальи.</Source>
</section>
<section class="scene section closing" id="discussion" data-title="Итоги и вопросы">
<p class="eyebrow" data-reveal>11 / Итоги</p><h2 data-reveal>Новый масштаб.<br/>Следующий полный сезон.</h2><div class="closing-points"><p><span>01</span>Инвестиции создали новую инфраструктуру.</p><p><span>02</span>Первые данные показывают рост спроса и улучшение результата.</p><p><span>03</span>Полный эффект зависит от календаря ввода и загрузки.</p></div><div class="closing-bottom"><strong>Вопросы и обсуждение</strong><a href="#investment">Вернуться к финансовому блоку ↗</a></div>
</section>
</main>
<footer class="footer"><div class="footer-top"><img src={asset('skazka-logo.svg')} width="151" height="40" alt="Сказка"/><p>Инвест День 2026<br/><span>Редакция 10 сентября 2026</span></p><a href="#start">К началу ↑</a></div><details id="sources" class="sources"><summary>Источники, периоды и статус данных</summary><p>Презентация подготовлена по предоставленному финансовому пакету и стратегическому контексту. Первичные отчёты и выгрузки отдельно не проверялись. Оценки, расчёты и целевые ориентиры отмечены рядом с показателями.</p><div class="sources-grid">{sources.map(s=><article id={s.id}><h3>{s.title}</h3><p>{s.description}</p></article>)}</div><p>Фотографии: <a href="https://parkskazka.ru/o-parke" target="_blank" rel="noopener noreferrer">официальный сайт Парка Сказка</a>. Логотип предоставлен заказчиком. Плановые показатели не являются гарантией будущих результатов.</p></details></footer>
