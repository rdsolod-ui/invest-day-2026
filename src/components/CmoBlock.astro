---
import GeoFlight from './GeoFlight.astro';
import SeasonSales from './SeasonSales.astro';import NightSales from './NightSales.astro';import admissions from '../data/admission-sales.json';import night from '../data/night-sales.json';import events from '../data/season-events.json';import MetricArea from './MetricArea.astro';import season from '../data/season-sales.json';
import Stage from './CmoStage.astro';import Head from './SectionHead.astro';import data from '../data/marketing.json';
const {total}=Astro.props;const asset=(s:string)=>`${import.meta.env.BASE_URL.replace(/\/$/,'')}/assets/${s}`;
const n=(v:number,d=0)=>new Intl.NumberFormat('ru-RU',{maximumFractionDigits:d,minimumFractionDigits:d}).format(v);
const monthNames=['Янв','Фев','Мар','Апр','Май','Июн','Июл','Авг','Сен'];const seasonMonths=data.months.filter(m=>m.month>=4&&m.month<=9);
const metrics=[{key:'tickets_all',name:'Проданные билеты, шт.',unit:'',digits:0},{key:'coverage',name:'Покрытие атрибуцией, %',unit:'',digits:2},{key:'cps',name:'Маркетинговый CPS, ₽',unit:'',digits:0},{key:'romi',name:'ROMI, %',unit:'',digits:1}];
const dateLabel=(date:string)=>date.slice(8)+'.'+date.slice(5,7);
const journeys=[{segment:'Семья',before:'Отдельные активности',after:'Целый день в парке',value:'Единый билет · питание · праздник'},{segment:'Компания друзей',before:'Привычный дневной досуг',after:'Экстрим и Night Riders',value:'Новый повод собраться вместе'},{segment:'Гость из МО',before:'Поиск отдыха рядом',after:'Поездка ради впечатлений',value:'Выбор продукта до выезда'}];
---
<Stage id="core-product" title="Первый шаг: новая билетная система" index={10} total={total}>
<Head eyebrow="Первое решение" title="Первый шаг — новая билетная система." description="Я начал с пересмотра тарифной сетки основного продукта — под парк, в который приезжают на целый день."/>
<div class="core-shift"><article class="core-before" data-flow><span class="label">Отправная точка</span><h3>Отдельное<br/>катание</h3><p>Выбор отдельных активностей</p></article><span class="core-arrow" aria-hidden="true" data-reveal>→</span><article class="core-after" data-flow><span class="label">Новая логика продукта</span><h3>Единый билет.<br/>Целый день.</h3><p>Ценность всего визита в парк</p></article></div>
<div class="core-actions">{[{n:'01',h:'Пересмотр тарифов',p:'Билетная система под новый масштаб парка'},{n:'02',h:'Ценность для гостя',p:'Разные сценарии отдыха в одном месте'},{n:'03',h:'Развитие продукта',p:'Новые аудитории, форматы и поводы вернуться'}].map(x=><article data-flow><span>{x.n}</span><h3>{x.h}</h3><p>{x.p}</p></article>)}</div>
</Stage>
<Stage id="scale" title="Москва и Подмосковье" index={11} total={total}>
<Head eyebrow="География роста" title="Москва + Подмосковье." description="Три этапа привлечения: Москва, западные посёлки и остальные направления Московской области."/>
<div class="geo-layout"><GeoFlight/><div class="geo-layers"><article data-flow><span>01 / Москва</span><h3>Город по удалённости</h3><p>Последовательный охват районов с учётом времени поездки в парк.</p></article><article data-flow><span>02 / Запад МО</span><h3>Западные коттеджные посёлки</h3><p>Семейный день, премиальные впечатления, праздники и встречи друзей.</p></article><article data-flow><span>03 / Расширение</span><h3>Остальные направления МО</h3><p>Последовательно по удалённости от Москвы и удобству поездки в парк.</p></article><div class="channel-strip" data-reveal><span>Контекстная реклама</span><span>Таргетная реклама</span><span>SEO</span></div></div></div>
<p class="stage-note">Стратегия привлечения. Схема показывает приоритеты, а не измеренный охват аудитории.</p>
</Stage>
<Stage id="product" title="Новые аттракционы" index={12} total={total}>
<Head eyebrow="Развитие продукта" title="Новый масштаб аттракционов."/>
<div class="attraction-gallery">
{[{name:'Паук',image:'pauk.webp'},{name:'Смерч',image:'smerch.webp'},{name:'Вихрь',image:'vihr.webp'},{name:'Бумеранг',image:'bumerang.webp'},{name:'Путь Дракона',image:'dragon.webp'},{name:'Сердце Москвы',image:'heart-moscow.webp',future:true}].map(ride=><figure class:list={['photo','attraction-card',{'attraction-future':ride.future}]} data-flow>
<img src={asset(ride.image)} alt={ride.future?'Сердце Москвы — аттракцион пока не открыт':ride.name} loading="lazy"/>
{ride.future&&<div class="attraction-status"><svg viewBox="0 0 32 32" aria-hidden="true"><path d="M4 17h6l3-8 5 15 3-7h7"/></svg><span>Пока не открыт</span></div>}
<figcaption>{ride.future&&<span class="attraction-next">Следующий запуск</span>}<h3>{ride.name}</h3></figcaption>
</figure>)}
</div>
<div class="attraction-segments" data-reveal>Поклонники экстрима <span>×</span> Компании друзей <span>×</span> Семьи с подростками</div>
</Stage>
<Stage id="night-riders" title="Кейс Night Riders" index={13} total={total} night>
<Head eyebrow="Кейс нового формата" title="Night Riders: гипотеза стала продуктом." description="Гипотеза: ночные катания и музыка создают отдельный повод для компаний друзей и любителей экстрима."/>
<div class="night-kpis"><div data-reveal><strong>{n(night.total.net_tickets)}</strong><span>билетов после возвратов</span></div><div data-reveal><strong>{n(night.total.net_revenue/1e6,2)} <small>млн ₽</small></strong><span>выручки после возвратов</span></div><div data-reveal><strong>{night.hoursPerNight} <small>часа</small></strong><span>работы парка за одну ночь</span></div></div>
<div class="night-case"><figure class="photo night-case-photo" data-reveal><img src={asset('night-riders.webp')} alt="Ночные аттракционы Night Riders" loading="lazy"/><figcaption>Новый повод.<br/>Новая аудитория.</figcaption></figure><NightSales/></div>
<div class="night-process">{['Гипотеза аудитории','Пилот формата','Измерение продаж','Развитие продукта'].map(t=><span data-flow>{t}</span>)}</div>
</Stage>
<Stage id="cjm" title="CJM: было — стало" index={14} total={total}>
<Head eyebrow="Новые ценности для аудитории" title="Меняется причина поездки." description="Единая билетная система объединяет разные активности в понятный сценарий целого визита."/>
<div class="cjm-table"><div class="cjm-header"><span>Сегмент</span><span>Было</span><span></span><span>Стало / новая ценность</span></div>{journeys.map(j=><article class="cjm-row" data-flow><h3>{j.segment}</h3><p class="cjm-before">{j.before}</p><span class="cjm-arrow">→</span><div><h3>{j.after}</h3><p>{j.value}</p></div></article>)}</div>
<div class="journey-steps">{['Увидел свой повод','Выбрал формат','Купил до визита','Приехал за впечатлением'].map((x,i)=><div data-flow><span>0{i+1}</span>{x}</div>)}</div><p class="stage-note">Карта изменения предложения. Эффект на конверсию оценивается отдельно по сегментам.</p>
</Stage>
<Stage id="marketing-funnel" title="Продажи за сезон и ParkOps" index={15} total={total}>
<Head eyebrow="Маркетинг и продажи" title="Продажи билетов за сезон." description={`Платные билеты и пакеты в парк · все каналы · сезон с 1 апреля по ${dateLabel(admissions.cutoff)}.2026.`}/>
<div class="season-sales-layout"><SeasonSales/><aside class="season-journal" aria-label="Легенда пинов и журнал событий 2026"><span class="label">2026 / Журнал событий</span><h3>Запуски сезона</h3><ol>{events.filter(e=>e.date<=admissions.cutoff).map(e=><li class={`pin-${e.kind}`} data-flow data-journal-id={e.id}><time class="journal-date" datetime={e.date}>{dateLabel(e.date)}</time><div><h4>{e.title}</h4><p>{e.detail}</p></div></li>)}</ol><p class="journal-source">ParkOps · собственная сквозная аналитика</p></aside></div>
</Stage>
<Stage id="marketing-budget" title="Расход по месяцам" index={16} total={total}>
<Head eyebrow="Помесячный расход" title="Бюджет в динамике сезона." description="Доли фактического расхода с НДС по месяцам. Яндекс.Директ · сезон 01.04–14.09.2026."/>
<div class="budget-chart" aria-label="Доли учтённого расхода по месяцам, проценты">{season.budget.map(m=><div class="budget-column"><strong>{n(m.spend/season.budgetTotal*100,1)}%</strong><div class="budget-space"><div class="cmo-bar" data-grow style={`height:${m.spend/12e6*100}%`}></div></div><span>{m.partial?'Сен · 1–14':monthNames[m.month-1]}</span></div>)}</div><div class="budget-footer"><strong>100<small>%</small></strong><p>учтённого расхода с НДС<br/>за 01.04–14.09.2026</p></div><p class="stage-note">Сентябрь — 1–14 число, текущий день неполный. Яндекс.Директ с НДС, не весь бюджет. Доли округлены до 0,1 п.п.</p>
</Stage>
<Stage id="marketing-performance" title="CPS, ROMI и продажи" index={17} total={total}>
<Head eyebrow="Эффективность маркетинга" title="Продажи и стоимость привлечения." description="Апрель–сентябрь 2026 · помесячно. Проданные билеты — кассы и сайт."/>
<div class="performance-grid">{metrics.map((metric,i)=><MetricArea id={`metric-${metric.key}`} name={metric.name} unit={metric.unit} values={seasonMonths.map(m=>metric.key==='tickets_all'?admissions.seasons[1].daily.filter(d=>Number(d.date.slice(5,7))===m.month).reduce((sum,d)=>sum+d.tickets_sold,0):Number(m[metric.key as keyof typeof m]))} labels={seasonMonths.map(m=>m.month===9?`Сен · 1–${metric.key==='tickets_all'?Number(admissions.cutoff.slice(8)):14}`:monthNames[m.month-1])} digits={metric.digits} color={i+1}/>)}</div>
</Stage>
<Stage id="cross-sales" title="Карта кросс-продаж" index={18} total={total}>
<Head eyebrow="Следующий повод приехать" title="Один визит открывает следующий." description="Карта кросс-продаж: знакомим гостя с другими продуктами парка и поводами вернуться."/>
<div class="cross-map"><svg class="cross-lines" viewBox="0 0 1600 530" aria-hidden="true"><path d="M800 260L270 90M800 260L1330 90M800 260L270 420M800 260L1330 420" data-draw/></svg><div class="cross-center" data-reveal>ГОСТЬ<span>Впечатление → следующий повод</span></div><article class="cross-node node-ticket" data-flow><h3>Билеты в парк</h3><p>Единый билет · новые экстрим-аттракционы</p></article><article class="cross-node node-event" data-flow><h3>Фестивали и события</h3><p>Night Riders · Dream Riders</p></article><article class="cross-node node-food" data-flow><h3>Партнёрский фуд</h3><p>Покупка в текущем визите · продолжение дня в парке</p></article><article class="cross-node node-party" data-flow><h3>Корпоративы и дни рождения</h3><p>Личный опыт → праздник для группы</p></article></div>
</Stage>
<Stage id="cmo-plans" title="Планы CMO на сезон" index={19} total={total}>
<Head eyebrow="Планы на новый сезон" title="Новый масштаб отношений с гостем." description="Продукт → аудитория → повторный визит. Три связанных драйвера следующего сезона."/>
<div class="cmo-plan-grid"><article data-flow><span class="plan-num">01</span><figure class="plan-photo"><img src={asset('heart-moscow.webp')} alt="Аттракцион Сердце Москвы — подготовка к открытию" loading="lazy"/></figure><h3>Сердце Москвы</h3><p>Запуск — новый повод приехать и расширить сценарий посещения парка.</p><p class="plan-measure">Новый продукт → интерес к визиту<br/>Измеряем: продажи и катания</p></article><article data-flow><span class="plan-num">02</span><figure class="plan-photo"><img src={asset('plans-geo-3d.webp')} alt="3D-концепция Москвы и западных коттеджных посёлков Подмосковья" loading="lazy"/></figure><h3>Новые аудитории и география</h3><p>Москва и МО: западные посёлки, затем остальные направления по удалённости.</p><p class="plan-measure">Шире аудитория → новые гости<br/>Измеряем: география и CPS</p></article><article data-flow><span class="plan-num">03</span><figure class="plan-photo plan-phone"><img src={asset('plans-app-iphone-brand.webp')} alt="Концепт мобильного приложения Сказка на iPhone: вход в личный кабинет" loading="lazy"/></figure><h3>Лояльность в цифровом формате</h3><p>Развитие программы через личный кабинет и создание Web App.</p><p class="plan-measure">Удобнее возвращаться → повтор<br/>Измеряем: повторные покупки</p></article></div><div class="product-loop">{['Гипотеза','MVP','Измерение','Развитие'].map(t=><span data-flow>{t}</span>)}</div>
</Stage>
