---
import SeasonSales from './SeasonSales.astro';import MetricArea from './MetricArea.astro';import PlanVisual from './PlanVisual.astro';import season from '../data/season-sales.json';
import Stage from './CmoStage.astro';import Head from './SectionHead.astro';import data from '../data/marketing.json';
const {total}=Astro.props;const asset=(s:string)=>`${import.meta.env.BASE_URL.replace(/\/$/,'')}/assets/${s}`;
const n=(v:number,d=0)=>new Intl.NumberFormat('ru-RU',{maximumFractionDigits:d,minimumFractionDigits:d}).format(v);
const monthNames=['Янв','Фев','Мар','Апр','Май','Июн','Июл','Авг','Сен'];const summer=data.months.slice(5);
const metrics=[{key:'tickets_all',name:'Проданные билеты, шт.',unit:'Все позиции в классификации ParkOps',digits:0},{key:'spend_with_vat',name:'Расход с НДС, млн ₽',unit:'Учтённый расход Яндекс.Директа',digits:2,div:1e6},{key:'cps',name:'Маркетинговый CPS, ₽',unit:'Расход / билет с атрибуцией',digits:0},{key:'romi',name:'ROMI, %',unit:'(Атриб. выручка − расход) / расход',digits:1}];
const sum=(key:string)=>data.night.reduce((s,r)=>s+Number(r[key as keyof typeof r]),0);
const journeys=[{segment:'Семья',before:'Отдельные активности',after:'Целый день в парке',value:'Единый билет · питание · праздник'},{segment:'Компания друзей',before:'Привычный дневной досуг',after:'Экстрим и Night Riders',value:'Новый повод собраться вместе'},{segment:'Гость из МО',before:'Поиск отдыха рядом',after:'Поездка ради впечатлений',value:'Выбор продукта до выезда'}];
---
<Stage id="scale" title="Москва и Подмосковье" index={5} total={total}>
<Head eyebrow="CMO / География роста" title="Москва + Подмосковье." description="Приоритет привлечения: от западных коттеджных посёлков — к другим направлениям МО."/>
<div class="geo-layout"><div class="geo-orbits" aria-label="Схема приоритетов географии, не карта охвата"><div class="geo-ring ring-outer" data-flow></div><div class="geo-ring ring-inner" data-flow></div><div class="geo-core" data-reveal>СКАЗКА<span>Крылатское</span></div><span class="geo-pin pin-west" data-reveal>Запад МО</span><span class="geo-pin pin-city" data-reveal>Москва</span><span class="geo-pin pin-region" data-reveal>Другие направления МО</span></div><div class="geo-layers"><article data-flow><span>01 / Первый слой</span><h3>Западные коттеджные посёлки</h3><p>Семейный день, премиальные впечатления, праздники и встречи друзей.</p></article><article data-flow><span>02 / Расширение</span><h3>Остальные направления МО</h3><p>Последовательно по удалённости от Москвы и удобству поездки в парк.</p></article><div class="channel-strip" data-reveal><span>Контекстная реклама</span><span>Таргетная реклама</span><span>SEO</span></div></div></div>
<p class="stage-note">Стратегия привлечения. Схема показывает приоритеты, а не измеренный охват аудитории.</p>
</Stage>
<Stage id="product" title="Плотность впечатлений" index={6} total={total}>
<Head eyebrow="CMO / Продукт для новых сегментов" title="Больше экстрима за один визит." description="Разные сценарии катания в одном парке — повод приехать компанией и попробовать новое."/>
<div class="extreme-layout"><div class="extreme-photos"><figure class="photo" data-reveal><img src={asset('bumerang.webp')} alt="Бумеранг" loading="lazy"/><figcaption>Бумеранг</figcaption></figure><figure class="photo" data-reveal><img src={asset('smerch.webp')} alt="Смерч" loading="lazy"/><figcaption>Смерч</figcaption></figure><figure class="photo" data-reveal><img src={asset('dragon.webp')} alt="Путь Дракона" loading="lazy"/><figcaption>Путь Дракона</figcaption></figure></div><div class="extreme-numbers"><div data-reveal><strong>5</strong><span>новых объектов в замере</span></div><div data-reveal><strong>152,3 <small>тыс.</small></strong><span>проходов за 1–27 августа 2026</span></div><div data-reveal><strong>13,3%</strong><span>всех проходов за этот период</span></div></div></div>
<div class="segment-line" data-reveal>Поклонники экстрима <span>×</span> Компании друзей <span>×</span> Семьи с подростками</div>
<p class="stage-note">Проходы — катания, не уникальные гости. Сегменты — адресаты предложения; их доли не измерены здесь.</p>
</Stage>
<Stage id="night-riders" title="Кейс Night Riders" index={7} total={total} night>
<Head eyebrow="CMO / Кейс нового формата" title="Night Riders. Другая ночь." description="Ночные катания и музыка: самостоятельный повод приехать для компаний друзей и любителей экстрима."/>
<div class="night-case"><figure class="photo night-case-photo" data-reveal><img src={asset('night-riders.webp')} alt="Ночные аттракционы Night Riders" loading="lazy"/><figcaption>Новая ценность:<br/>парк после наступления темноты</figcaption></figure><div><div class="night-kpis"><div data-reveal><strong>{n(sum('net_tickets'))}</strong><span>билетов после возвратов</span></div><div data-reveal><strong>{n(sum('net_revenue')/1e6,2)} <small>млн ₽</small></strong><span>выручки после возвратов</span></div></div><div class="night-bars" aria-label="Билеты после возвратов по датам Night Riders">{data.night.map(r=><div class="night-bar-col"><strong>{n(r.net_tickets)}</strong><div class="night-bar-space"><div class="cmo-bar" style={`height:${r.net_tickets/2600*100}%`} data-grow></div></div><span>{r.day} августа</span></div>)}</div><p class="cmo-caption">Четыре даты · продажи в августе 2026</p></div></div>
<p class="stage-note">{n(sum('tickets_sold'))} продано − {n(sum('returned'))} возвратов. Онлайн и касса; дата билета не равна дате покупки. Это продажи, не посещаемость.</p>
</Stage>
<Stage id="cjm" title="CJM: было — стало" index={8} total={total}>
<Head eyebrow="CMO / Новые ценности для аудитории" title="Меняется причина поездки." description="CJM: от выбора отдельной активности — к выбору сценария целого визита."/>
<div class="cjm-table"><div class="cjm-header"><span>Сегмент</span><span>Было</span><span></span><span>Стало / новая ценность</span></div>{journeys.map(j=><article class="cjm-row" data-flow><h3>{j.segment}</h3><p class="cjm-before">{j.before}</p><span class="cjm-arrow">→</span><div><h3>{j.after}</h3><p>{j.value}</p></div></article>)}</div>
<div class="journey-steps">{['Увидел свой повод','Выбрал формат','Купил до визита','Приехал за впечатлением'].map((x,i)=><div data-flow><span>0{i+1}</span>{x}</div>)}</div><p class="stage-note">Карта изменения предложения. Эффект на конверсию оценивается отдельно по сегментам.</p>
</Stage>
<Stage id="marketing-funnel" title="Продажи за сезон и ParkOps" index={9} total={total}>
<Head eyebrow="CMO / Маркетинг и продажи" title="Продажи билетов за сезон." description="Все каналы продаж. 01.04–11.09.2026 в сравнении с 01.04–30.09.2025."/>
<div class="season-sales-layout"><SeasonSales/><div class="parkops-card season-parkops" data-reveal><span class="label">Собственный IT-продукт</span><h3>ParkOps</h3><p>Сквозная аналитика маркетинга и продаж.</p><div class="parkops-chain">{['Все каналы продаж','Проданные билеты, шт.','Динамика сезона','Ежедневный срез'].map(x=><div data-flow>{x}</div>)}</div><span class="cmo-caption">2026: по 11 сентября включительно</span></div></div><p class="stage-note">До вычета возвратов. Классификатор ParkOps включает сервисные позиции. 11.09 — неполный день; периоды различаются.</p>
</Stage>
<Stage id="marketing-budget" title="Расход по месяцам" index={10} total={total}>
<Head eyebrow="CMO / Помесячный расход" title="Бюджет в динамике сезона." description="Фактический расход с НДС, учтённый в MarketingOps по Яндекс.Директу. Сезон: 01.04–11.09.2026."/>
<div class="budget-chart" aria-label="Учтённый расход по месяцам, миллионы рублей">{season.budget.map(m=><div class="budget-column"><strong>{n(m.spend/1e6,2)}</strong><div class="budget-space"><div class="cmo-bar" data-grow style={`height:${m.spend/12e6*100}%`}></div></div><span>{m.partial?'Сен · 1–11':monthNames[m.month-1]}</span></div>)}</div><div class="budget-footer"><strong>{n(season.budgetTotal/1e6,2)} <small>млн ₽</small></strong><p>суммарный учтённый расход с НДС<br/>за 01.04–11.09.2026</p></div><p class="stage-note">Сентябрь — 1–11 число, текущий день неполный. Учтённый расход Яндекс.Директа с НДС, не полный бюджет всех каналов.</p>
</Stage>
<Stage id="marketing-performance" title="CPS, ROMI и продажи" index={11} total={total}>
<Head eyebrow="CMO / Эффективность маркетинга" title="Продажи и стоимость привлечения." description="Июнь–август 2026. Показатели в определениях ParkOps; каждый график имеет свою шкалу от нуля."/>
<div class="performance-grid">{metrics.map((metric,i)=><MetricArea id={`metric-${metric.key}`} name={metric.name} unit={metric.unit} values={summer.map(m=>Number(m[metric.key as keyof typeof m])/(metric.div||1))} labels={summer.map(m=>monthNames[m.month-1])} digits={metric.digits} color={i+1}/>)}</div><p class="stage-note">Атрибуция билетов: 15,27% → 19,55% → 19,35%. ROMI по выручке, без себестоимости. «Билеты» включают сервисные позиции ParkOps.</p>
</Stage>
<Stage id="cross-sales" title="Карта кросс-продаж" index={12} total={total}>
<Head eyebrow="CMO / Следующий повод приехать" title="Один визит открывает следующий." description="Карта кросс-продаж: знакомим гостя с другими продуктами парка и поводами вернуться."/>
<div class="cross-map"><svg class="cross-lines" viewBox="0 0 1600 530" aria-hidden="true"><path d="M800 260L270 90M800 260L1330 90M800 260L270 420M800 260L1330 420" data-draw/></svg><div class="cross-center" data-reveal>ГОСТЬ<span>Впечатление → следующий повод</span></div><article class="cross-node node-ticket" data-flow><h3>Билеты в парк</h3><p>Единый билет · новые экстрим-аттракционы</p></article><article class="cross-node node-event" data-flow><h3>Фестивали и события</h3><p>Night Riders · Dream Riders</p></article><article class="cross-node node-food" data-flow><h3>Фуд-точки</h3><p>Продолжение дня в парке</p></article><article class="cross-node node-party" data-flow><h3>Корпоративы и дни рождения</h3><p>Личный опыт → праздник для группы</p></article></div><p class="stage-note">Схема возможностей кросс-продаж, а не измеренные переходы между покупками.</p>
</Stage>
<Stage id="cmo-plans" title="Планы CMO на сезон" index={13} total={total}>
<Head eyebrow="CMO / Планы на новый сезон" title="Новый масштаб отношений с гостем." description="Три направления развития продукта, аудитории и повторных продаж."/>
<div class="cmo-plan-grid"><article data-flow><span class="plan-num">01</span><h3>Сердце Москвы</h3><p>Запуск — новый повод приехать и расширить сценарий посещения парка.</p><PlanVisual kind="heart"/></article><article data-flow><span class="plan-num">02</span><h3>Новые аудитории и география</h3><p>Москва и МО: западные посёлки, затем остальные направления по удалённости.</p><PlanVisual kind="geo"/></article><article data-flow><span class="plan-num">03</span><h3>Лояльность в цифровом формате</h3><p>Развитие программы через личный кабинет и создание Web App.</p><PlanVisual kind="app"/></article></div><p class="stage-note">Планы развития. Даты и числовые цели определяются отдельно.</p>
</Stage>
