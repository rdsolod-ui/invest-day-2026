---
import data from '../data/metrics.json';
const pts=data.oldPlan.filter(p=>p.year<=2028);const x=(i:number)=>120+i*310,y=(v:number)=>440-v/6*350;
const line=pts.map((p,i)=>`${i?'L':'M'}${x(i)},${y(p.revenue)}`).join(' ');const n=(v:number)=>v.toFixed(1).replace('.',',');
---
<div class="history-layout plan-history"><div class="history-plot"><div class="plan-legend"><span class="plan-dash"></span>Первоначальный план · млрд ₽</div><svg viewBox="0 0 1200 540" role="img" aria-label="Первоначальный план: 2025 — 2,4; 2026 — 4,2; 2027 — 4,7; 2028 — 5,4 млрд рублей. Это план, не факт."><defs><linearGradient id="plan-fill" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#3ebde6" stop-opacity=".35"/><stop offset="100%" stop-color="#3ebde6" stop-opacity="0"/></linearGradient><clipPath id="history-clip"><rect id="history-reveal" x="0" y="0" width="1200" height="540"/></clipPath></defs>{[0,2,4,6].map(v=><g class="history-gridline"><line x1="120" x2="1050" y1={y(v)} y2={y(v)}/><text x="60" y={y(v)+9}>{v}</text></g>)}<path d={line} class="history-ghost"/><g clip-path="url(#history-clip)"><path d={`${line} L1050,440 L120,440 Z`} fill="url(#plan-fill)"/><path d={line} class="history-line historical-dash"/></g>{pts.map((p,i)=><g class="history-point" data-point={i}><circle class="point-halo" cx={x(i)} cy={y(p.revenue)} r="19"/><circle class="point-core" cx={x(i)} cy={y(p.revenue)} r="8"/><text class="point-value" x={x(i)} y={y(p.revenue)-30} text-anchor="middle">{n(p.revenue)}</text><text class="point-year" x={x(i)} y="495" text-anchor="middle">{p.year}</text></g>)}</svg><div class="history-select">{pts.map((p,i)=><button data-history-year={i} data-reveal-width={x(i)+25} aria-pressed={i===0?'true':'false'}>{p.year}</button>)}</div></div><div class="history-inspector"><div class="inspector-top"><span class="label">Первоначальная модель</span><button class="loop-toggle" data-loop="history" aria-pressed="false" aria-label="Приостановить анимацию графика">Ⅱ</button></div>{pts.map((p,i)=><article class={`history-hint ${i===0?'selected':''}`} data-history-hint={i}><span class="hint-status">Исторический план</span><h3>{p.year}</h3><strong>{n(p.revenue)} <small>млрд ₽</small></strong><p>плановая выручка</p><div class="plan-shift"><span>Полный сезон новых мощностей</span><b>2026 → 2027</b></div></article>)}<div class="cycle-track"><span></span></div></div></div>
