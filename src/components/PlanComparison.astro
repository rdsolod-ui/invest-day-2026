---
import finance from '../data/finance-2026.json';
const m=finance.model;const n=(v:number,d=0)=>new Intl.NumberFormat('ru-RU',{maximumFractionDigits:d}).format(v);
const x=(i:number)=>140+i*286;const top=48,bottom=231;
const charts=[{key:'revenue',title:'Выручка',data:m.revenue,max:6,ticks:[0,2,4,6],digits:1},{key:'ebitda',title:'EBITDA',data:m.ebitda,max:3200,ticks:[0,1000,2000,3000],digits:0}];
---
<div class="finance-model">
<div class="model-legend"><span><i class="legend-original"></i>Исходный план</span><span><i class="legend-fact"></i>Факт</span><span><i class="legend-forecast"></i>Обновлённый прогноз</span><button class="loop-toggle" data-loop="history" aria-pressed="false" aria-label="Приостановить анимацию графика">Ⅱ</button></div>
<div class="model-plots">{charts.map(c=>{const y=(v:number)=>bottom-v/c.max*(bottom-top);const line=(vs:number[],offset=0)=>vs.map((v,i)=>`${i?'L':'M'}${x(i+offset)},${y(v)}`).join(' ');return <div class="model-plot"><div class="model-plot-label"><h3>{c.title}</h3><span>{c.data.unit}</span></div><svg viewBox="0 0 1680 295" role="img" aria-label={`${c.title}. Исходный план: ${c.data.original.join('; ')}. Факт 2024–2025 и прогноз 2026–2029: ${c.data.updated.join('; ')}. ${c.data.unit}.`}>
<defs><linearGradient id={`model-fill-${c.key}`} x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="var(--blue)" stop-opacity=".16"/><stop offset="100%" stop-color="var(--blue)" stop-opacity="0"/></linearGradient></defs>
<rect class="model-forecast-zone" x="569" y="0" width="1065" height="244" rx="8"/><text class="model-status" x="142" y="26">ФАКТ · 2024–2025</text><text class="model-status" x="590" y="26">ПРОГНОЗ · 2026–2029</text>
{c.ticks.map(t=><g class="model-grid"><line x1="140" x2="1570" y1={y(t)} y2={y(t)}/><text x="94" y={y(t)+8} text-anchor="end">{n(t)}</text></g>)}
<path class="model-fill" data-area d={`${line(c.data.updated)} L1570,${bottom} L140,${bottom} Z`} fill={`url(#model-fill-${c.key})`}/><path class="model-original" data-draw d={line(c.data.original)}/><path class="model-actual" data-draw d={line(c.data.updated.slice(0,2))}/><path class="model-predicted" data-area d={line(c.data.updated.slice(1),1)}/>
{m.years.map((yr,i)=><g data-model-point={i} class:list={['model-point',{'selected':i===0}]}><line class="model-cursor" x1={x(i)} x2={x(i)} y1="38" y2="244"/><circle class="model-old-point" cx={x(i)} cy={y(c.data.original[i])} r="5"/><circle class="model-new-point" cx={x(i)} cy={y(c.data.updated[i])} r="7"/><text class="model-number" x={x(i)} y={y(c.data.updated[i])+(c.data.updated[i]>c.data.original[i]?-14:30)} text-anchor="middle">{n(c.data.updated[i],c.digits)}</text><text class="model-year" x={x(i)} y="285" text-anchor="middle">{yr}</text></g>)}
</svg></div>})}</div>
<div class="model-footer"><div class="model-year-buttons" aria-label="Выбрать год модели">{m.years.map((yr,i)=><button data-model-year={i} aria-pressed={i===0?'true':'false'}>{yr}</button>)}</div><div class="model-hints">{m.years.map((yr,i)=><p data-model-hint={i} hidden={i!==0}><strong>{yr} · {m.status[i]==='fact'?'Факт':'Прогноз'}</strong><span>План → {m.status[i]==='fact'?'факт':'прогноз'}: {n(m.revenue.original[i],1)} → {n(m.revenue.updated[i],1)} млрд ₽ · {n(m.ebitda.original[i])} → {n(m.ebitda.updated[i])} млн ₽</span></p>)}</div></div>
</div>
