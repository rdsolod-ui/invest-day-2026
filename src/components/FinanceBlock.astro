---
import Stage from './CmoStage.astro';import Head from './SectionHead.astro';import PlanComparison from './PlanComparison.astro';import data from '../data/finance-2026.json';
const {total}=Astro.props;const asset=(s:string)=>`${import.meta.env.BASE_URL.replace(/\/$/,'')}/assets/${s}`;const n=(v:number,d=1)=>new Intl.NumberFormat('ru-RU',{minimumFractionDigits:d,maximumFractionDigits:d}).format(v);
const f=data.halfYear,a=data.august,d=data.demand;const growth=(a.revenueRub[1]/a.revenueRub[0]-1)*100;
---
<Stage id="investment" title="Инвестиции и активы" index={21} total={total} className="finance-scene">
<Head eyebrow="Инвестиции и активы" title="Создана база нового масштаба." description="Инвестиции парка и партнёров превратились в инфраструктуру и новые объекты."/>
<div class="fin-assets"><article data-flow><strong>≈ {n(data.investment.billionRub)}</strong><span>млрд ₽</span><p>совокупные инвестиции<br/>парка и партнёров</p></article><article data-flow><strong>{data.investment.hectares}</strong><span>гектаров</span><p>новая<br/>экстрим-зона</p></article><article data-flow><strong>{data.investment.objects}</strong><span>аттракциона и локации</span><p><b>{data.investment.own}</b> собственных <i>/</i> <b>{data.investment.partners}</b> партнёрских</p></article></div>
<div class="fin-partnership"><figure><img src={asset('bumerang.webp')} alt="Аттракцион Бумеранг в парке Сказка" loading="lazy"/></figure><div><article data-flow><h3>Парк</h3><p>Инфраструктура · поток гостей<br/>единая билетная система</p></article><article data-flow><h3>Партнёры</h3><p>Часть капитальных вложений<br/>и оборудования</p></article></div></div>
</Stage>
<Stage id="baseline" title="Финансовый план" index={22} total={total} className="finance-scene finance-model-scene">
<Head eyebrow="Финансовая траектория · 2024–2029" title="Целевые уровни. Новый календарь."/>
<PlanComparison/>
</Stage>
<Stage id="demand" title="Трафик и конверсия" index={23} total={total} className="finance-scene">
<Head eyebrow="Трафик и конверсия" title="Больше гостей выбирают билет." description="Трафик × конверсия × средний чек — три драйвера выручки."/>
<div class="fin-demand-grid"><article data-flow><div class="fin-year">2025 <span>Факт</span></div><strong>{n(d.conversion[0])}<small>%</small></strong><p class="fin-conversion-label">конверсия</p><div class="fin-traffic"><b>1,2 млн</b><span>трафик</span></div></article><article class="fin-current" data-flow><div class="fin-year">2026 <span>Факт / ожидание года</span></div><strong>{n(d.conversion[1])}<small>%</small></strong><p class="fin-conversion-label">конверсия</p><div class="fin-traffic"><b>{n(d.trafficAugust2026,0)}</b><span>трафик на конец августа</span></div><p class="fin-expectation">≈1,3 млн — ожидание года</p></article><article class="fin-future" data-flow><div class="fin-year">2027 <span>Прогноз</span></div><strong>30–35<small>%</small></strong><p class="fin-conversion-label">целевая конверсия</p><div class="fin-traffic"><b>2,5 млн</b><span>целевой трафик</span></div><p class="fin-expectation">Рост среднего чека</p></article></div>
<div class="fin-ticket-band" data-reveal><div><span>Билеты · апрель–август 2025 → 2026</span><b>{n(d.tickets[0],0)} <i>→</i> {n(d.tickets[1],0)}</b></div><strong>+{Math.round((d.tickets[1]/d.tickets[0]-1)*100)}<small>%</small></strong></div>
</Stage>
<Stage id="finance" title="Эффективность первого полугодия" index={24} total={total} className="finance-scene">
<Head eyebrow="Операционная эффективность · 1П2025 → 1П2026" title="Переход от убытка к прибыли." description="Эффективность улучшилась ещё до полного эффекта новых мощностей."/>
<div class="fin-efficiency"><article data-flow><h3>Выручка</h3><strong>+{n((f.revenue[1]/f.revenue[0]-1)*100)}<small>%</small></strong><div class="fin-mini-bars" aria-hidden="true">{f.revenue.map(v=><span data-grow style={`height:${v/500*120}px`}></span>)}</div><p>{n(f.revenue[0])} → {n(f.revenue[1])}</p><span class="fin-unit">млн ₽</span></article><article class="fin-profit" data-flow><h3>Прибыль от продаж</h3><div class="fin-profit-values"><span>−42,4<small>1П2025</small></span><i>→</i><strong>+76,7<small>1П2026</small></strong></div><div class="fin-profit-scale"><span class="fin-loss"></span><i>0</i><span class="fin-gain" data-grow></span></div><p><b>+{n(f.operatingProfit[1]-f.operatingProfit[0])} млн ₽</b><span>улучшение результата</span></p></article><article data-flow><h3>Расходная база</h3><strong>−{Math.round((1-f.expenseBase[1]/f.expenseBase[0])*100)}<small>%</small></strong><div class="fin-mini-bars" aria-hidden="true">{f.expenseBase.map(v=><span data-grow style={`height:${v/500*120}px`}></span>)}</div><p>{n(f.expenseBase[0])} → {n(f.expenseBase[1])}</p><span class="fin-unit">млн ₽ · совокупно 20+26+44</span></article></div>
<div class="fin-gross" data-reveal><span>Валовая прибыль</span><b>{n(f.grossProfit[0])} → {n(f.grossProfit[1])} млн ₽</b><strong>+{n((f.grossProfit[1]/f.grossProfit[0]-1)*100)}%</strong></div>
</Stage>
<Stage id="calendar" title="Поэтапные запуски" index={25} total={total} className="finance-scene">
<Head eyebrow="Календарь запусков · 2026" title="Новые мощности — шаг за шагом." description="Первые проходы в билетной системе. Объекты включались в работу по ходу сезона."/>
<div class="fin-calendar"><div class="fin-calendar-toolbar"><span>Май — октябрь 2026</span><button class="loop-toggle" data-loop="calendar" aria-pressed="false" aria-label="Приостановить анимацию календаря">Ⅱ</button></div><div class="fin-months">{data.launches.map((v,i)=><button class:list={['fin-month',{'selected':i===0,'fin-month-planned':v.status==='planned'}]} data-event={i} aria-pressed={i===0?'true':'false'}><span class="fin-month-label">{v.month}</span><div class="fin-month-photo">{v.image?<img src={asset(v.image)} alt={v.objects.join(' и ')} loading="lazy"/>:<svg viewBox="0 0 240 180" aria-hidden="true"><circle cx="120" cy="90" r="42" fill="var(--cyan)"/><ellipse cx="120" cy="90" rx="100" ry="25" transform="rotate(-25 120 90)" fill="none" stroke="var(--blue)" stroke-width="7"/><circle cx="201" cy="24" r="7" fill="var(--blue)"/></svg>}</div><h3>{v.objects.map((name,j)=><>{j>0&&<br/>}{name}</>)}</h3><span class="fin-month-status">{v.status==='planned'?'План · ПНР':'В работе'}</span><span class="event-progress"></span></button>)}</div><button class="fin-full-season" data-event={6} aria-pressed="false"><strong>2027</strong><span>Первый полный сезон<br/>новой конфигурации парка</span><b>→</b><span class="event-progress"></span></button><div class="fin-calendar-hint">{data.launches.map((v,i)=><p data-event-hint={i} hidden={i!==0}><b>{v.objects.join(' и ')}</b><span>{v.status==='planned'?'Смонтировано · пусконаладка · план запуска во II половине октября':'Первые проходы — '+v.month.toLowerCase()+' 2026'}</span></p>)}<p data-event-hint={6} hidden><b>Полный сезон</b><span>Возможность реализовать потенциал всех новых мощностей</span></p></div></div>
</Stage>
<Stage id="revenue-impact" title="Фактический эффект новых аттракционов" index={26} total={total} className="finance-scene">
<Head eyebrow="Фактический результат · август" title="Новые аттракционы дают выручку." description="Эффект инвестпрограммы уже виден при неполном сезоне работы новых объектов."/>
<div class="fin-august"><div class="fin-august-comparison"><div class="fin-august-values"><article><span>Август 2025</span><b>{n(a.revenueRub[0]/1e6)}</b></article><i>→</i><article><span>Август 2026</span><b>{n(a.revenueRub[1]/1e6)}</b></article></div><span class="fin-unit">млн ₽ выручки</span><strong class="fin-august-growth" data-reveal>+{n(growth)}<small>%</small></strong><figure><img src={asset('bumerang.webp')} alt="Бумеранг — новый аттракцион парка" loading="lazy"/></figure></div><div class="fin-august-chain"><article data-flow><strong>{a.newObjects}</strong><p>новых работающих<br/>аттракционов</p></article><article data-flow><strong>{n(a.rides,0)}</strong><p>проходов<br/>на новых аттракционах</p></article><article data-flow><strong>{n(a.newRevenueRub/1e6)}<small>млн ₽</small></strong><p>выручка<br/>новых аттракционов</p></article><article data-flow><strong>{n(a.newRevenueRub/a.revenueRub[1]*100)}<small>%</small></strong><p>от всей выручки<br/>парка за август</p></article></div></div>
</Stage>
<Stage id="execution" title="Купон, ставка и погашение" index={27} total={total} className="finance-scene">
<Head eyebrow="Обязательства перед инвесторами" title="Купон. Ставка. Погашение." description="Обслуживание займа — за счёт собственной выручки парка."/>
<div class="fin-bonds"><article data-flow><span class="fin-bond-step">01 · Купон</span><strong>01.10.2026</strong><h3>Выплата 8-го купона</h3><p>В полном объёме<br/>и в установленный срок.</p></article><article data-flow><span class="fin-bond-step">02 · Ставка</span><strong>9–12</strong><h3>Купонные периоды</h3><p>Официальное раскрытие<br/>в установленном порядке.</p></article><article data-flow><span class="fin-bond-step">03 · Погашение</span><strong>30.09.2027</strong><h3>Финальное погашение</h3><p>{data.bonds.issue}<br/>{data.bonds.isin}</p></article></div>
<div class="fin-bond-thesis" data-reveal><p>Сроки реализации инвестиционной программы изменились.</p><strong>Обязательства перед инвесторами — нет.</strong></div>
</Stage>
