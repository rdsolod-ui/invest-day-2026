---
import Stage from './CmoStage.astro';import Head from './SectionHead.astro';import Chart from './ComparisonChart.astro';import PlanComparison from './PlanComparison.astro';import data from '../data/metrics.json';import august from '../data/august-sales.json';
const {total}=Astro.props;const asset=(s:string)=>`${import.meta.env.BASE_URL.replace(/\/$/,'')}/assets/${s}`;const n=(v:number,d=1)=>new Intl.NumberFormat('ru-RU',{minimumFractionDigits:d,maximumFractionDigits:d}).format(v);const rows=data.finance.rows;const growth=(august.years[1].netRevenue/august.years[0].netRevenue-1)*100;
const years=[{year:2027,tag:'Первый полный сезон',title:'Загрузить мощности',items:['Работа новых объектов весь сезон','Контроль расходов и операционной эффективности'],hint:'Фокус — реализовать потенциал введённых объектов и управлять экономикой полного сезона.'},{year:2028,tag:'Следующий этап',title:'Закрепить результат',items:['Повторные визиты и устойчивый спрос','Дисциплина затрат и денежных потоков'],hint:'Фокус — устойчивость результата, повторные продажи и качество финансового планирования.'}];
---
<Stage id="investment" title="Инвестиции и партнёрская модель" index={20} total={total}>
<Head eyebrow="Финансы / Созданная база" title="Инвестиции становятся продуктом." description="Совместная модель парка и партнёров: инфраструктура, оборудование и готовность к работе."/>
<div class="investment-revision"><div class="investment-total" data-reveal><span class="label">Совокупная управленческая оценка</span><strong>≈ 2,5</strong><span class="investment-unit">млрд ₽</span><p>вложения парка и партнёров</p><figure class="photo"><img src={asset('bumerang.webp')} alt="Бумеранг — оборудование в парке Сказка" loading="lazy"/></figure></div><div class="investment-roles"><article data-flow><span>01 / Парк</span><h3>Среда и инфраструктура</h3><p>Территория, сети, основания, маршруты и привлечение гостей.</p></article><article data-flow><span>02 / Партнёры</span><h3>Часть оборудования</h3><p>Участие в финансировании аттракционов и расширении предложения.</p></article><div class="revision-takeaway" data-reveal>Общая база <span>→</span> Общий продукт</div></div></div><p class="stage-note">Оценка совокупных вложений. Не равна сумме облигационного займа или капитальным затратам одного юридического лица.</p>
</Stage>
<Stage id="baseline" title="План и изменение календаря" index={21} total={total}>
<Head eyebrow="Финансы / История планирования" title="План зависит от календаря запуска." description="Первоначальные ориентиры и сдвиг полного сезона новых мощностей на 2027 год."/>
<PlanComparison/><p class="stage-note">Пунктир — первоначальный план, не фактическая выручка. Обновлённая финансовая траектория — после согласования модели.</p>
</Stage>
<Stage id="demand" title="Платящий спрос" index={22} total={total}>
<Head eyebrow="Финансы / Продажи и ценность" title="Больше гостей выбирают билет." description="Оплаченные билеты: апрель–август 2025 и 2026. Сопоставимый период исходного финансового блока."/>
<div class="demand-revision"><div><Chart title="Оплаченные билеты" values={data.demand.tickets.map(v=>v/1000)} max={300} labels={['2025','2026']} unit="тыс. билетов"/><div class="demand-growth" data-reveal><strong>+{n((data.demand.tickets[1]/data.demand.tickets[0]-1)*100)}%</strong><p>127 706 → 249 007<br/>оплаченных билетов</p></div></div><div class="conversion-story"><span class="label">Механизм роста продаж</span>{['Понятный сценарий дня','Ценность единого билета','Решение о покупке'].map((t,i)=><article data-flow><span>0{i+1}</span><h3>{t}</h3></article>)}<p>Продукт и билетная модель работают вместе.</p></div></div><p class="stage-note">Билеты не равны уникальным гостям. Для измерения конверсии нужен независимый замер входящего потока.</p>
</Stage>
<Stage id="calendar" title="Сдвиг полного сезона" index={23} total={total}>
<Head eyebrow="Финансы / Календарь реализации" title="Полный сезон — следующий этап." description="Поздние запуски сместили время реализации потенциала новых мощностей."/>
<div class="schedule-lanes"><div class="schedule-label">Первоначальный<br/>календарь</div><article data-flow><span>2025</span><h3>Ввод объектов</h3><p>План запуска новых мощностей</p></article><article data-flow><span>2026</span><h3>Полный сезон</h3><p>Исходное ожидание модели</p></article><div class="schedule-label">Обновлённый<br/>календарь</div><article class="schedule-actual" data-flow><span>2025–2026</span><h3>Сдвиг ввода</h3><p>Поставки, монтаж и поздний коммерческий запуск</p></article><article class="schedule-future" data-flow><span>2027</span><h3>Полный сезон</h3><p>Ожидание работы новых объектов весь высокий сезон</p></article></div><div class="schedule-track" data-reveal><span>Поставка</span><b>→</b><span>Монтаж</span><b>→</b><span>Пусконаладка</span><b>→</b><span>Коммерческий запуск</span></div><p class="stage-note">2027 — ориентир полного сезона. «Сердце Москвы» — подготовка к запуску; точная дата зависит от готовности объекта.</p>
</Stage>
<Stage id="finance" title="Результат первого полугодия" index={24} total={total}>
<Head eyebrow="Финансы / Первое полугодие" title="Улучшение результата до запусков." description="Первое полугодие 2025 и 2026. Показатели исходного финансового блока, млн ₽."/>
<div class="finance-revision"><div class="financial-bars"><Chart title="Выручка" values={rows[0].values} max={500} labels={['1П2025','1П2026']} unit="млн ₽"/><Chart title="Валовая прибыль" values={rows[1].values} max={350} labels={['1П2025','1П2026']} unit="млн ₽"/></div><div class="finance-result"><div class="result-card" data-reveal><span class="label">Результат от продаж · млн ₽</span><div class="result-compare"><span class="old-result">−42,4<small>1П2025</small></span><span class="result-arrow">→</span><strong>+76,7<small>1П2026</small></strong></div></div><div class="net-result" data-reveal><span class="label">Чистый результат · млн ₽</span><strong>−77,5 <span>→</span> +2,7</strong><p>1П2025 → 1П2026</p></div><div class="finance-focus" data-reveal><b>Фокус финансовой команды</b><p>Структура затрат · планирование платежей · контроль эффективности</p></div></div></div><p class="stage-note">Сравнение отдельных финансовых строк. Механизм и размер эффекта оптимизации требуют отдельной сверки.</p>
</Stage>
<Stage id="revenue-impact" title="Август после запусков" index={25} total={total}>
<Head eyebrow="Финансы / Первые результаты" title="Август показывает новый масштаб." description="Билетные продажи после возвратов, все каналы ParkOps. Сопоставление августа 2025 и 2026."/>
<div class="august-revision"><div class="august-pairs">{august.years.map((v,i)=><article class:list={['august-card',{'august-current':i===1}]} data-flow><span class="label">Август {v.year}</span><strong>{n(v.netRevenue/1e6,2)}</strong><span>млн ₽ после возвратов</span></article>)}<div class="august-change" data-reveal><strong>+{n(growth)}%</strong><p>к августу 2025</p></div></div><div class="august-context"><figure class="photo"><img src={asset('bumerang.webp')} alt="Аттракцион Бумеранг" loading="lazy"/><figcaption>Новые объекты · новые события</figcaption></figure><p>Рост наблюдается на фоне расширения продукта. Вклад каждого запуска оценивается отдельно.</p></div></div><p class="stage-note">По дате продажи; партнёры и сервисные позиции включены. Это оборот билетных продаж, не выручка юридического лица и не прибыль.</p>
</Stage>
<Stage id="targets" title="Финансовые задачи 2027–2028" index={26} total={total}>
<Head eyebrow="Финансы / Перспектива" title="2027–2028. Загрузка и эффективность." description="Два этапа финансовой работы: полный сезон новых мощностей и устойчивость результата."/>
<div class="event-calendar revision-calendar"><div class="calendar-toolbar"><span class="label">Календарь задач</span><span>2027 — 2028</span><button class="loop-toggle" data-loop="calendar" aria-pressed="false" aria-label="Приостановить анимацию календаря">Ⅱ</button></div><div class="event-grid">{years.map((t,i)=><button class={`event-card ${i===0?'selected':''}`} data-event={i} aria-pressed={i===0?'true':'false'} aria-describedby="calendar-hint"><div class="calendar-binding"><i></i><i></i></div><div class="event-year">{t.year}</div><span class="event-tag">{t.tag}</span><h3>{t.title}</h3>{t.items.map(v=><p class="calendar-task">{v}</p>)}<div class="event-progress"></div></button>)}</div><div class="calendar-hint" id="calendar-hint"><span class="hint-marker">↗</span><div>{years.map((t,i)=><p data-event-hint={i} hidden={i!==0}><strong>{t.year}</strong>{t.hint}</p>)}</div></div></div><p class="stage-note">Планы работы. Числовые цели по выручке и EBITDA — после согласования обновлённой финансовой модели.</p>
</Stage>
<Stage id="execution" title="Обязательства перед инвесторами" index={27} total={total}>
<Head eyebrow="Финансы / Инвесторы" title="Прозрачность. Дисциплина. Диалог." description="Финансовая команда связывает планы развития с денежными потоками и обязательствами выпуска."/>
<div class="bond-grid">{[{n:'01',h:'Купонный график',p:'Планирование денежных потоков под обязательства выпуска.'},{n:'02',h:'Официальное раскрытие',p:'Параметры следующих периодов — в опубликованных решениях эмитента.'},{n:'03',h:'Открытый диалог',p:'Результаты, предпосылки плана и ответы на вопросы инвесторов.'}].map(x=><article data-flow><span>{x.n}</span><h3>{x.h}</h3><p>{x.p}</p></article>)}</div><div class="bond-identifier" data-reveal><span class="label">Облигационный выпуск</span><strong>БО-П01</strong><span>RU000A109PK2</span></div><p class="stage-note">Параметры выпуска определяются официальными документами эмитента. Далее — вопросы и обсуждение.</p>
</Stage>
