---
import Stage from './CmoStage.astro';import Head from './SectionHead.astro';
const {total}=Astro.props;const asset=(s:string)=>`${import.meta.env.BASE_URL.replace(/\/$/,'')}/assets/${s}`;
---
<Stage id="industry-location" title="Локация и барьеры входа" index={3} total={total}>
<Head eyebrow="Индустрия" title="Парк начинается с места." description="Городская территория, инфраструктура и инвестиции создают основу, которую сложно воспроизвести."/>
<div class="location-maps"><figure class="location-map" data-reveal><figcaption>Окружение парка <span>Магистрали · станции метро</span></figcaption><img src={asset('map-context.webp')} alt="Гибридная карта Яндекса: Сказка, МКАД, проспект Маршала Жукова и станции метро вокруг парка"/></figure><figure class="location-map" data-reveal><figcaption>Территория <span>Крупный план</span></figcaption><img src={asset('map-park.webp')} alt="Гибридная карта Яндекса: территория парка Сказка и ближайшее окружение"/></figure></div>
<div class="location-factors">{[{n:'01',h:'Территория',p:'Городская локация'},{n:'02',h:'Инфраструктура',p:'Сети и гостевая среда'},{n:'03',h:'Инвестиции',p:'Оборудование и монтаж'}].map(x=><article data-flow><span>{x.n}</span><div><h3>{x.h}</h3><p>{x.p}</p></div></article>)}</div>
<p class="stage-note">Локация — одно из конкурентных преимуществ парка. Земля и инфраструктура определяют возможности развития.</p>
</Stage>
<Stage id="industry-assets" title="Жизненный цикл активов" index={4} total={total}>
<Head eyebrow="Экономика активов" title="Создаём на годы. Обновляем системно." description="Первоначальные вложения и дальнейшее обслуживание — разные этапы жизненного цикла."/>
<div class="asset-lifecycle">{[{n:'01',h:'Создать',p:'Оборудование · монтаж · инфраструктура'},{n:'02',h:'Обслуживать',p:'Контроль состояния · регламентные работы'},{n:'03',h:'Обновлять',p:'Ремонт · замена компонентов · реконструкция'}].map(x=><article data-flow><span class="label">{x.n}</span><h3>{x.h}</h3><p>{x.p}</p></article>)}</div>
<div class="asset-example"><div><span class="label">Американские горки · Efteling</span><strong data-reveal>1981 <span>→</span> 2018</strong></div><div><h3>Долгая эксплуатация.<br/>Масштабная реконструкция.</h3><p>В 2018 году, после 36 лет эксплуатации, в Efteling обновили рельсовую конструкцию американских горок, сохранив знакомый маршрут катания.</p></div></div>
<p class="stage-note">10 лет в рассматриваемой модели — период до капитального ремонта, а не предельный срок эксплуатации аттракциона.</p>
</Stage>
<Stage id="industry-generations" title="Межпоколенческий спрос" index={5} total={total}>
<Head eyebrow="Повторяемый спрос" title="Дети вырастают. Впечатления остаются." description="Парк развивается вместе с гостями: от первого семейного визита — к новым поводам вернуться."/>
<div class="revision-split"><figure class="photo revision-photo"><img src={asset('babl-star.webp')} alt="Семейный аттракцион Бабл Стар в парке Сказка" loading="lazy"/><figcaption>Один парк · разные поколения гостей</figcaption></figure><div class="generation-column"><div class="generation-route">{['В детстве — с родителями','Позже — с друзьями','Со своими детьми'].map((x,i)=><div data-flow><span>0{i+1}</span><h3>{x}</h3></div>)}</div><div class="heritage-dates"><div data-reveal><span>Liseberg</span><strong>1923</strong><p>год открытия</p></div><div data-reveal><span>Efteling</span><strong>1952</strong><p>год открытия</p></div></div></div></div>
<p class="stage-note">История парков показывает длительность жизни формата. Доход и посещаемость зависят от продукта, спроса и условий работы.</p>
</Stage>
<Stage id="industry-choice" title="Выбор парка и сценария" index={6} total={total}>
<Head eyebrow="Конкуренция" title="Один сезон. Разные поводы приехать." description="Гость выбирает сочетание места, впечатления и времени. Семейный досуг может включать несколько парков."/>
<div class="choice-calendar">{[{tag:'Семейный день',h:'Вместе',p:'Аттракционы и прогулка',image:'gusenitsa.webp'},{tag:'Компания друзей',h:'За экстримом',p:'Новые ощущения и новые объекты',image:'dragon.webp'},{tag:'Особое событие',h:'За атмосферой',p:'Музыка, вечер и программа',image:'night-riders.webp'}].map(x=><article data-flow><figure class="photo"><img src={asset(x.image)} alt={x.p} loading="lazy"/><figcaption>{x.tag}</figcaption></figure><h3>{x.h}</h3><p>{x.p}</p></article>)}</div>
<div class="revision-takeaway" data-reveal>Локация <span>×</span> Продукт <span>×</span> Повод</div>
</Stage>
<Stage id="story" title="От районного к городскому" index={7} total={total}>
<Head eyebrow="Трансформация" title="От катания рядом — к поездке на день." description="Масштаб предложения меняет билетную модель, географию гостей и сценарий визита."/>
<div class="scale-journey"><article data-flow><span class="label">Районный парк</span><h3>Одно<br/>катание</h3><p>Локальная аудитория<br/>и отдельные активности</p></article><article class="scale-current" data-flow><span class="label">Городской парк · Сказка</span><h3>Целый<br/>день</h3><p>Единый билет, разные сценарии<br/>и более широкая география</p></article><article data-flow><span class="label">Туристический формат</span><h3>Цель<br/>поездки</h3><p>Отдых, который планируют<br/>как самостоятельное путешествие</p></article></div>
<div class="revision-takeaway" data-reveal>Больше продукта <span>→</span> Больше ценности визита</div>
</Stage>
<Stage id="industry-city" title="Социальная роль парка" index={8} total={total}>
<Head eyebrow="Городская жизнь" title="Место, которое объединяет." description="Отдых, события и социальные программы делают парк частью жизни города."/>
<div class="city-story"><figure class="photo"><img src={asset('social-husky.webp')} alt="Ребёнок с хаски в парке Сказка" loading="lazy"/><figcaption>Городской отдых</figcaption></figure><div class="city-program" data-reveal><span class="label">Социальная программа Сказки</span><h3>Подари<br/>ребёнку<br/>радость</h3><p>Визиты подопечных фондов и социальных организаций. Компании поддерживают программу, парк готовит день впечатлений.</p></div><figure class="photo"><img src={asset('social-alpaca.webp')} alt="Знакомство с альпакой в парке Сказка" loading="lazy"/><figcaption>Общий день впечатлений</figcaption></figure></div>

</Stage>
